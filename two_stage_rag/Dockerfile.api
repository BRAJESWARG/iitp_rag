# Two-Stage RAG — FastAPI backend (CPU-only)
# Build context = the two_stage_rag/ directory.
FROM python:3.12-slim

WORKDIR /app

# Install CPU-only PyTorch FIRST (avoids the multi-GB CUDA build pulled in by
# sentence-transformers), then the rest of the deps.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

# App code + the pre-ingested sample index (chroma_db).
COPY *.py ./
COPY sample_docs ./sample_docs
COPY chroma_db ./chroma_db

# Embedding + reranker models download on first query (~180 MB) unless baked in.
EXPOSE 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
